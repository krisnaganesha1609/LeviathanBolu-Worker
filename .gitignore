models/
*.onnx
*.bin
*.pt
*.pth
*.safetensors

# FunASR / ModelScope auto-downloaded weights cache
# (lives in ~/.cache inside container, but guard against local runs too)
~/.cache/modelscope/
~/.cache/funasr/
.cache/

# ── Docker ────────────────────────────────────────────────────────────────────
