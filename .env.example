LEVIATHAN_ENV=         
LOG_LEVEL=
LOG_JSON=

AUDIO_SAMPLE_RATE=16000
AUDIO_CHANNELS=1
AUDIO_FRAME_MS=20                  # 20ms @ 16kHz = 320 samples = 640 bytes

STT_HOST=
STT_PORT=
STT_ENGINE=                   
STT_MODEL=
STT_DEVICE=                     
STT_COMPUTE_TYPE=              
STT_USE_GPU=
STT_CPU_THREADS=
STT_BEAM_SIZE=
STT_LANGUAGE=

STT_VAD_SILENCE_MS=
STT_VAD_RMS_THRESHOLD=
STT_PARTIAL_INTERVAL_MS=
STT_MAX_SILENCE_SECONDS=
STT_MAX_SESSION_SECONDS=
STT_MIN_UTTERANCE_MS=
STT_SILERO_VAD_THRESHOLD=

STT_PREROLL_MS=
STT_POSTROLL_MS=
STT_SLIDING_WINDOW_SECONDS=

# Debug: dump every finalized utterance as .wav so you can listen to
# exactly what the worker received. Empty = disabled.
STT_DEBUG_DUMP_AUDIO_DIR=

TTS_HOST=0.0.0.0
TTS_PORT=9002
TTS_ENGINE=dummy                   
TTS_MODEL_PATH=/models/kokoro-v1.0.onnx
TTS_VOICES_PATH=/models/voices-v1.0.bin
TTS_USE_GPU=false
TTS_CHUNK_PACE=false              
TTS_MAX_SESSION_SECONDS=60

HEALTH_PATH=
METRICS_PATH=
